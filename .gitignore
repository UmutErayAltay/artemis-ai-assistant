# Sanal ortam (varsa) — binlerce paket dosyası; bunlar git/VS Code
# tarafından izlenirse "10000+ changes" gibi anormal şişmelere yol açar.
venv/
.venv/
env/
ENV/

# Python cache/derlenmiş dosyalar
__pycache__/
*.pyc
*.pyo
.pytest_cache/
*.egg-info/

# Artemis'e özel: log ve hafıza dosyaları versiyon kontrolüne girmemeli
logs/*.log
memory/*.db

# API anahtarları — BU DEPO HERKESE AÇIK. Anahtarlar yalnızca ortam
# değişkeninde veya bu ignore edilen dosyada tutulur (bkz.
# config/settings.py::get_groq_api_key). Asla config.yaml'a yazmayın.
config/secrets.yaml
.env

# Ses modelleri (Vosk/Piper) yüzlerce MB'tır; repoya girmemeli, gerekirse
# `python scripts/setup_voice.py` ile yeniden indirilir.
voice_models/

# IDE / OS
.vscode/
.idea/
Thumbs.db
.DS_Store
